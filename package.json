{
  "name": "sqlite2pg",
  "version": "1.0.0",
  "description": "Modern Zero-Config SQLite to PostgreSQL & Supabase Exporter and Migrator",
  "bin": {
    "sqlite2pg": "./bin/sqlite2pg.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx src/cli.ts"
  },
  "keywords": [
    "sqlite",
    "postgresql",
