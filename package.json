    "neon",
    "sqlite-to-postgres",
    "sqlite2pg",
    "sqlite-converter",
    "sqlite3-dump",
    "sqlite-to-postgresql",
    "migrate-sqlite-to-supabase",
    "database-migration",
    "libsql",
    "turso",
    "sql-converter",
    "pgloader-alternative",
    "postgresql-migration",
    "sqlite-dump-postgres",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "pg": "^8.13.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
